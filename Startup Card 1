<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GridSense Technologies · VCAS</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=IBM+Plex+Serif:wght@400;600&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --navy: #0f2044; --blue: #1e4fd8; --blue-lt: #e8eefb;
  --green: #15803d; --green-bg: #f0fdf4;
  --amber: #92400e; --amber-bg: #fffbeb;
  --slate: #475569; --slate-lt: #94a3b8; --line: #e2e8f0;
  --bg: #f8fafc; --white: #ffffff; --text: #1e293b;
}
body {
  font-family: 'IBM Plex Sans', sans-serif;
  background: var(--bg);
  min-height: 100vh;
  display: flex; align-items: flex-start; justify-content: center;
  padding: 2rem 1.5rem;
}
.card {
  width: 100%; max-width: 900px;
  background: var(--white);
  border-radius: 12px;
  box-shadow: 0 2px 24px rgba(15,32,68,.10), 0 1px 4px rgba(15,32,68,.06);
  overflow: hidden;
}

/* HEADER */
.header {
  background: var(--navy); padding: 18px 24px;
  display: grid; grid-template-columns: auto 1fr auto;
  align-items: center; gap: 16px;
}
.rang {
  background: var(--blue); color: #fff;
  font-size: 10px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 5px; white-space: nowrap;
}
.company-name { font-family: 'IBM Plex Serif', serif; color: #fff; font-size: 20px; font-weight: 600; }
.header-meta {
  display: flex; gap: 10px; flex-wrap: wrap;
  color: rgba(255,255,255,.5); font-size: 11.5px; margin-top: 3px;
}
.header-meta a { color: rgba(255,255,255,.65); text-decoration: none; border-bottom: 1px solid rgba(255,255,255,.2); }
.dot { color: rgba(255,255,255,.25); }
.header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.score-display { display: flex; align-items: baseline; gap: 3px; }
.score-num { font-family: 'IBM Plex Serif', serif; color: #fff; font-size: 34px; font-weight: 600; line-height: 1; }
.score-denom { color: rgba(255,255,255,.4); font-size: 13px; }
.badge { font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px; background: #15803d; color: #fff; }

/* BODY */
.body { display: grid; grid-template-columns: 268px 1fr; border-bottom: 1px solid var(--line); }

/* LEFT */
.left-col {
  background: #fafcff; border-right: 1px solid var(--line);
  padding: 20px; display: flex; flex-direction: column; gap: 20px;
}
.section-label {
  font-size: 9px; font-weight: 700; letter-spacing: .11em;
  text-transform: uppercase; color: var(--slate-lt); margin-bottom: 8px;
}
.radar-wrap { width: 100%; aspect-ratio: 1; max-width: 220px; margin: 0 auto; }
.score-rows { display: flex; flex-direction: column; gap: 6px; }
.score-row { display: flex; align-items: center; gap: 8px; }
.sr-label { font-size: 11px; color: var(--slate); width: 108px; flex-shrink: 0; }
.sr-track { flex: 1; height: 4px; background: var(--line); border-radius: 99px; overflow: hidden; }
.sr-fill { height: 100%; border-radius: 99px; background: var(--blue); }
.sr-val { font-size: 10.5px; font-weight: 600; color: var(--navy); width: 28px; text-align: right; }

/* RIGHT */
.right-col { padding: 20px 24px; display: flex; flex-direction: column; }
.content-block { padding-bottom: 16px; margin-bottom: 16px; border-bottom: 1px solid var(--line); }
.content-block:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.block-label {
  font-size: 9px; font-weight: 700; letter-spacing: .12em;
  text-transform: uppercase; color: var(--slate-lt);
  margin-bottom: 7px; display: flex; align-items: center; gap: 5px;
}
.block-text { font-size: 13px; line-height: 1.65; color: var(--text); }
.einschaetzung-text {
  font-family: 'IBM Plex Serif', serif;
  font-size: 13.5px; line-height: 1.55; color: var(--navy);
  border-left: 3px solid var(--blue); padding-left: 12px;
}

/* LÖSUNGSFIT */
.lf-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 10px;
}
.lf-total-badge {
  font-size: 11px; font-weight: 700; color: var(--blue);
  background: var(--blue-lt); padding: 2px 9px; border-radius: 20px;
}
.lf-rows { display: flex; flex-direction: column; gap: 8px; }
.lf-row { display: flex; align-items: center; gap: 0; }
.lf-code {
  font-size: 9.5px; font-weight: 700; letter-spacing: .05em;
  color: var(--blue); width: 22px; flex-shrink: 0;
}
.lf-name {
  font-size: 11.5px; font-weight: 500; color: var(--text);
  width: 150px; flex-shrink: 0;
}
.lf-bar-wrap { flex: 0 0 70px; margin: 0 8px; }
.lf-bar-track { height: 3px; background: var(--line); border-radius: 99px; overflow: hidden; }
.lf-bar-fill { height: 100%; border-radius: 99px; background: var(--blue); }
.lf-score {
  font-size: 10.5px; font-weight: 700; color: var(--navy);
  width: 28px; text-align: right; flex-shrink: 0;
}
.lf-icon { font-size: 12px; width: 20px; text-align: center; flex-shrink: 0; padding: 0 2px; }
.lf-note { font-size: 10.5px; color: var(--slate-lt); flex: 1; padding-left: 4px; font-style: italic; }

/* FOOTER */
.footer { display: grid; grid-template-columns: 1fr 1fr 1fr; }
.footer-cell { padding: 13px 18px; display: flex; flex-direction: column; gap: 4px; }
.footer-cell + .footer-cell { border-left: 1px solid var(--line); }
.fc-label { font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.fc-text { font-size: 12px; line-height: 1.5; color: var(--text); }
.fc-staerke { background: var(--green-bg); } .fc-staerke .fc-label { color: var(--green); }
.fc-risiko  { background: var(--amber-bg); } .fc-risiko  .fc-label { color: var(--amber); }
.fc-next    { background: var(--blue-lt);  } .fc-next    .fc-label { color: var(--blue);  }
</style>
</head>
<body>
<div class="card">

  <div class="header">
    <span class="rang">RANG 1</span>
    <div>
      <div class="company-name">GridSense Technologies</div>
      <div class="header-meta">
        <span>Berlin, DE</span><span class="dot">·</span>
        <span>Series A · €8,2 Mio.</span><span class="dot">·</span>
        <span>Gegr. 2019</span><span class="dot">·</span>
        <span>45–60 MA</span><span class="dot">·</span>
        <span><a href="https://www.gridsense.io" target="_blank">gridsense.io ↗</a></span>
      </div>
    </div>
    <div class="header-right">
      <div class="score-display">
        <span class="score-num">82</span>
        <span class="score-denom">/100</span>
      </div>
      <span class="badge">✅ Shortlist</span>
    </div>
  </div>

  <div class="body">
    <div class="left-col">
      <div>
        <div class="section-label">Scoring-Profil</div>
        <div class="radar-wrap"><canvas id="radar"></canvas></div>
      </div>
      <div>
        <div class="section-label">Scores</div>
        <div class="score-rows">
          <div class="score-row">
            <span class="sr-label">Lösungsfit</span>
            <div class="sr-track"><div class="sr-fill" style="width:92.5%"></div></div>
            <span class="sr-val">37/40</span>
          </div>
          <div class="score-row">
            <span class="sr-label">Umsetzungsreife</span>
            <div class="sr-track"><div class="sr-fill" style="width:88.0%"></div></div>
            <span class="sr-val">22/25</span>
          </div>
          <div class="score-row">
            <span class="sr-label">Vertrauenswürd.</span>
            <div class="sr-track"><div class="sr-fill" style="width:76.0%"></div></div>
            <span class="sr-val">19/25</span>
          </div>
          <div class="score-row">
            <span class="sr-label">Marktvalidierung</span>
            <div class="sr-track"><div class="sr-fill" style="width:40.0%"></div></div>
            <span class="sr-val">4/10</span>
          </div>
        </div>
      </div>
    </div>

    <div class="right-col">
      <div class="content-block">
        <div class="block-label">🏢 Unternehmensbeschreibung</div>
        <div class="block-text">KI-gestütztes Lastmanagement für industrielle Netze — spezialisiert auf Prozessindustrie & SCADA-Integration. SAP-zertifiziert, ISO 27001 auditiert.</div>
      </div>
      <div class="content-block">
        <div class="block-label">💡 Analyst-Einschätzung</div>
        <div class="einschaetzung-text">Einziger Kandidat mit SAP-Zertifizierung und Live-Referenz in der Prozessindustrie. Stärkstes Compliance-Paket im Feld — Runway-Situation vor Pilotzusage prüfen.</div>
      </div>
      <div class="content-block">
        <div class="lf-header">
          <div class="block-label" style="margin-bottom:0">🎯 Lösungsfit-Aufschlüsselung</div>
          <span class="lf-total-badge">37 / 40 Pkt.</span>
        </div>
        <div class="lf-rows"><div class="lf-row">
          <span class="lf-code">1A</span>
          <span class="lf-name">Feature Match</span>
          <div class="lf-bar-wrap"><div class="lf-bar-track"><div class="lf-bar-fill" style="width:93.3%"></div></div></div>
          <span class="lf-score">14/15</span>
          <span class="lf-icon">✅</span>
          <span class="lf-note">Kernfunktionen vollständig nachgewiesen</span>
        </div><div class="lf-row">
          <span class="lf-code">1B</span>
          <span class="lf-name">Branchenspez. Nachweis</span>
          <div class="lf-bar-wrap"><div class="lf-bar-track"><div class="lf-bar-fill" style="width:100.0%"></div></div></div>
          <span class="lf-score">10/10</span>
          <span class="lf-icon">✅</span>
          <span class="lf-note">2 Named References · gleiche Industrie</span>
        </div><div class="lf-row">
          <span class="lf-code">1C</span>
          <span class="lf-name">Technischer Stack-Fit</span>
          <div class="lf-bar-wrap"><div class="lf-bar-track"><div class="lf-bar-fill" style="width:90.0%"></div></div></div>
          <span class="lf-score">9/10</span>
          <span class="lf-icon">✅</span>
          <span class="lf-note">SAP-Zertifikat · SCADA · API-Doku öffentlich</span>
        </div><div class="lf-row">
          <span class="lf-code">1D</span>
          <span class="lf-name">Use-Case-Bonus</span>
          <div class="lf-bar-wrap"><div class="lf-bar-track"><div class="lf-bar-fill" style="width:80.0%"></div></div></div>
          <span class="lf-score">4/5</span>
          <span class="lf-icon">🟡</span>
          <span class="lf-note">Spezialist Prozessindustrie · kein Cloud-only</span>
        </div></div>
      </div>
    </div>
  </div>

  <div class="footer">
    <div class="footer-cell fc-staerke">
      <span class="fc-label">⚡ Stärke</span>
      <span class="fc-text">ISO 27001 + 2 Named References im DAX-Umfeld.</span>
    </div>
    <div class="footer-cell fc-risiko">
      <span class="fc-label">⚠️ Risiko</span>
      <span class="fc-text">Runway-Berechnung unsicher — Datum letzte Runde nicht verfügbar.</span>
    </div>
    <div class="footer-cell fc-next">
      <span class="fc-label">→ Nächster Schritt</span>
      <span class="fc-text">Demo anfragen · Fokus: SAP-Integration live + Pilotbedingungen.</span>
    </div>
  </div>
</div>

<script>
new Chart(document.getElementById('radar').getContext('2d'), {
  type: 'radar',
  data: {
    labels: ['Lösungsfit', 'Umsetzungs-\nreife', 'Vertrauens-\nwürdigkeit', 'Markt-\nvalidierung'],
    datasets: [{
      data: [92.5, 88.0, 76.0, 40.0],
      backgroundColor: 'rgba(30,79,216,0.12)',
      borderColor: 'rgba(30,79,216,0.8)',
      borderWidth: 2,
      pointBackgroundColor: 'rgba(30,79,216,1)',
      pointBorderColor: '#fff', pointBorderWidth: 2,
      pointRadius: 4, pointHoverRadius: 6,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: true,
    layout: { padding: 14 },
    scales: { r: {
      min: 0, max: 100,
      ticks: { display: false, stepSize: 25 },
      grid: { color: '#e2e8f0' },
      angleLines: { color: '#e2e8f0' },
      pointLabels: {
        font: { family: 'IBM Plex Sans', size: 10, weight: '500' },
        color: '#475569', padding: 10,
      }
    } },
    plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.raw.toFixed(0)}%` } } }
  }
});
</script>
</body>
</html>
